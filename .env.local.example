# ─── AIMIND Environment Variables ───────────────────────────────────────────
# Copy file này thành .env.local và điền giá trị thực

# Gmail SMTP (Google App Password; chỉ cấu hình phía server)
GMAIL_USER=your-sender-email@example.com
GMAIL_PASS=your-google-app-password

# Bảo vệ endpoint nội bộ /api/test-email (tối thiểu 32 byte ngẫu nhiên)
ADMIN_SECRET=replace-with-a-cryptographically-random-secret

# App
NEXT_PUBLIC_APP_URL=https://aimind.com.vn
